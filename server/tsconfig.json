{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  // Tests are excluded from the BUILD config on purpose: they need jest globals
  // that this project deliberately doesn't declare, and `npm run build` (which
  // Railway runs on deploy) would otherwise fail on them. Test compilation is
  // owned by the root tsconfig.test.json / ts-jest instead.
  "exclude": ["node_modules", "dist", "src/**/__tests__/**", "src/**/*.test.ts"]
}
