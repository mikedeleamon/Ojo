+- (void)updateTabBarItem:(nullable UITabBarItem *)tabBarItem
+               withImage:(nullable UIImage *)image
+              isSelected:(BOOL)isSelected
+           forScreenView:(nullable RNSBottomTabsScreenComponentView *)screenView
+{
+  // Called from an asynchronous context. On iOS 26+ the tab bar item can
+  // already be gone, or the screen's controller detached from the
+  // UITabBarController, by the time the image arrives.
+  if (tabBarItem == nil || screenView == nil) {
+    return;
+  }
+
+  if (screenView.controller.parentViewController == nil) {
+    return;
+  }
+
+  if (isSelected) {
+    tabBarItem.selectedImage = image;
+  } else {
+    tabBarItem.image = image;
+  }
+}
