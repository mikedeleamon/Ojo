{
  "name": "ojo-native",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "clean": "chmod -R u+w ios/Pods 2>/dev/null; rm -rf node_modules ios/build ios/Pods ios/.xcode.env.local android/build android/.gradle",
    "clean-install": "rm -rf node_modules ios/build ios/Pods ios/.xcode.env.local android/build android/.gradle && npx expo install && cd ios && pod install && cd ..",
    "dev": "concurrently --names \"server,expo\" --prefix-colors \"cyan,magenta\" \"npm run dev --prefix server\" \"expo start\"",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "update": "node scripts/eas-update.js",
    "postinstall": "patch-package"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts",
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/server/src/**/__tests__/**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "dependencies": {
    "@expo/ui": "~58.0.27",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-native-picker/picker": "2.11.4",
    "@sentry/react-native": "~8.28.0",
    "@types/pako": "^2.0.4",
    "axios": "^1.15.2",
    "babel-preset-expo": "~58.0.0",
    "buffer": "^6.0.3",
    "expo": "^58.0.0",
    "expo-apple-authentication": "~58.0.2",
    "expo-blur": "~58.0.5",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.11",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-notifications": "~58.1.8",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.13",
    "expo-status-bar": "~58.0.4",
    "expo-store-review": "~58.0.2",
    "expo-updates": "~58.0.21",
    "pako": "^2.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-fast-tflite": "^3.0.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-nitro-modules": "^0.37.2",
    "react-native-purchases": "^10.9.0",
    "react-native-purchases-ui": "^10.9.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-share": "^12.3.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@bacons/apple-targets": "5.0.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.3.0",
    "babel-plugin-transform-remove-console": "^6.9.4",
    "concurrently": "^9.2.1",
    "jest": "^29.7.0",
    "patch-package": "^8.0.1",
    "ts-jest": "^29.4.11",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "jest",
        "@types/jest",
        "ts-jest"
      ]
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false,
        "exclude": [
          "react-native-fast-tflite"
        ]
      }
    }
  }
}
